# StyleSense — Frontend Environment Variables
# -----------------------------------------------
# INSTRUCTIONS:
#   1. Copy this file and rename the copy to:  .env.local
#   2. Replace the placeholder value with your real Railway backend URL
#   3. NEVER commit the real .env.local file to GitHub
# -----------------------------------------------

# The full URL of your deployed Railway backend — no trailing slash
# Example: https://stylesense-production.up.railway.app
# For local development, use: http://localhost:3001
NEXT_PUBLIC_API_URL=https://your-railway-app-url-here.railway.app
